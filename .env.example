# ---- Shared ----
APP_ENV=development                      # development | production
PUBLIC_APP_URL=http://localhost:3000

# ---- Postgres ----
POSTGRES_USER=blushcam
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=blushcam
DATABASE_URL=postgres://blushcam:change-me-locally@localhost:5432/blushcam?sslmode=disable

# ---- Go API ----
API_AUTO_MIGRATE=true                    # apply embedded SQL migrations on start (or run `api migrate`)
API_ADDR=:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
SESSION_COOKIE_NAME=blushcam_session
SESSION_TTL_HOURS=168
COOKIE_SECURE=false                      # MUST be true in production (HTTPS)
MAX_BODY_BYTES=1048576                   # JSON bodies
MAX_UPLOAD_BYTES=15728640                # 15 MiB per asset
USER_QUOTA_BYTES=524288000               # 500 MiB per user
AUTH_RATE_PER_MINUTE=10
PASSWORD_RESET_TTL_MINUTES=30
# SMTP is optional. If SMTP_HOST is empty, reset emails are NOT sent and the API says so (dev: token is logged only when APP_ENV=development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BlushCam <no-reply@example.com>

# ---- Storage ----
STORAGE_PROVIDER=local                   # local | s3
LOCAL_STORAGE_DIR=./storage-data
STORAGE_SIGNING_SECRET=generate-with-openssl-rand-hex-32
SIGNED_URL_TTL_SECONDS=300
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- Image service (Python) ----
IMAGE_SERVICE_URL=http://localhost:8000
IMAGE_SERVICE_TIMEOUT_SECONDS=20
IMAGE_MAX_BYTES=15728640
IMAGE_MAX_PIXELS=40000000
IMAGE_MAX_OUTPUT_PIXELS=60000000
IMAGE_PROCESS_TIMEOUT_SECONDS=20
# AI provider: none | remove_bg_http  (external provider => user consent is required in the UI)
AI_PROVIDER=none
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=

# ---- Frontend ----
API_INTERNAL_URL=http://localhost:8080   # where the Next.js server proxies /api/v1 (compose overrides to http://api:8080)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_CONTACT_EMAIL=
